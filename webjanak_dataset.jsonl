{"instruction": "Create a modern portfolio website with hero section, project gallery, skills grid, and contact form", "output": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Portfolio</title>\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }\n        .hero { height: 100vh; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; display: flex; align-items: center; justify-content: center; text-align: center; }\n        .hero h1 { font-size: 3.5rem; margin-bottom: 1rem; }\n        .btn { padding: 1rem 2rem; background: white; color: #667eea; border: none; border-radius: 50px; cursor: pointer; transition: transform 0.3s; }\n        .btn:hover {transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.2); }\n        .section { padding: 5rem 10%; }\n        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; }\n        .card { background: white; padding: 2rem; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.1); transition: transform 0.3s; }\n        .card:hover { transform: translateY(-10px); }\n        @media (max-width: 768px) { .hero h1 { font-size: 2rem; } }\n    </style>\n</head>\n<body>\n    <div class=\"hero\"><div><h1>Hi, I'm John Doe</h1><p>Full Stack Developer</p><button class=\"btn\">View Work</button></div></div>\n    <div class=\"section\" style=\"background: #f8f9fa;\"><h2 style=\"text-align: center; font-size: 2.5rem;\">Projects</h2>\n        <div class=\"grid\">\n            <div class=\"card\"><h3>E-Commerce</h3><p>React & Node.js</p></div>\n            <div class=\"card\"><h3>Weather App</h3><p>Real-time data</p></div>\n            <div class=\"card\"><h3>Task Manager</h3><p>Productivity</p></div>\n        </div>\n    </div>\n</body>\n</html>", "category": "Portfolio"}
{"instruction": "Create a modern coffee shop landing page with menu cards, about section, and location info", "output": "<!DOCTYPE html>\n<html>\n<head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>Coffee Shop</title>\n<style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: Arial; }\n.header { background: linear-gradient(to bottom, rgba(0,0,0,0.5), rgba(0,0,0,0.7)), #654321; height: 80vh; color: white; display: flex; align-items: center; justify-content: center; text-align: center; }\n.header h1 { font-size: 4rem; }\n.menu { padding: 4rem 10%; background: #f5f5f5; }\n.menu-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; }\n.menu-item { background: white; padding: 2rem; border-radius: 10px; text-align: center; box-shadow: 0 3px 10px rgba(0,0,0,0.1); }\n.price { font-size: 1.5rem; color: #d4af37; font-weight: bold; }\n</style>\n</head>\n<body>\n<div class=\"header\"><div><h1>☕ Artisan Coffee</h1><p>Crafted with Love</p></div></div>\n<div class=\"menu\"><h2 style=\"text-align: center; font-size: 2.5rem;\">Our Menu</h2>\n    <div class=\"menu-grid\">\n        <div class=\"menu-item\"><h3>Espresso</h3><p>Rich and bold</p><div class=\"price\">$3.50</div></div>\n        <div class=\"menu-item\"><h3>Cappuccino</h3><p>Smooth and creamy</p><div class=\"price\">$4.50</div></div>\n        <div class=\"menu-item\"><h3>Latte</h3><p>Perfect balance</p><div class=\"price\">$5.00</div></div>\n    </div>\n</div>\n</body>\n</html>", "category": "Coffee Shop"}
{"instruction": "Build a dashboard with sidebar, stats cards, and data table", "output": "<!DOCTYPE html><html><head><meta charset=\"UTF-8\"><title>Dashboard</title><style>* { margin: 0; padding: 0; box-sizing: border-box; } body { font-family: Arial; display: flex; } .sidebar { width: 250px; background: #2c3e50; color: white; min-height: 100vh; padding: 2rem 1rem; } .main { flex: 1; background: #ecf0f1; padding: 2rem; } .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; } .stat-card { background: white; padding: 1.5rem; border-radius: 10px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); } .stat-card .number { font-size: 2rem; font-weight: bold; color: #2c3e50; }</style></head><body><div class=\"sidebar\"><h2>Dashboard</h2><div>📊 Overview</div></div><div class=\"main\"><h1>Overview</h1><div class=\"stats\"><div class=\"stat-card\"><h3>Users</h3><div class=\"number\">12,459</div></div></div></div></body></html>", "category": "Dashboard"}
{"instruction": "Create a contact form with name, email, message fields", "output": "<!DOCTYPE html><html><head><meta charset=\"UTF-8\"><title>Contact Form</title><style>* { margin: 0; padding: 0; box-sizing: border-box; } body { font-family: Arial; background: linear-gradient(135deg, #667eea, #764ba2); min-height: 100vh; display: flex; align-items: center; justify-content: center; } form { background: white; padding: 3rem; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.2); max-width: 500px; width: 90%; } input, textarea { width: 100%; padding: 1rem; margin-bottom: 1rem; border: 2px solid #ddd; border-radius: 8px; } button { width: 100%; padding: 1rem; background: #667eea; color: white; border: none; border-radius: 8px; font-size: 1.1rem; cursor: pointer; }</style></head><body><form><h2>Contact Us</h2><input type=\"text\" placeholder=\"Name\" required><input type=\"email\" placeholder=\"Email\" required><textarea rows=\"5\" placeholder=\"Message\" required></textarea><button type=\"submit\">Send</button></form></body></html>", "category": "Forms"}
{"instruction": "Design a login page with email/password fields and social login buttons", "output": "<!DOCTYPE html><html><head><meta charset=\"UTF-8\"><title>Contact Form</title><style>* { margin: 0; padding: 0; box-sizing: border-box; } body { font-family: Arial; background: linear-gradient(135deg, #667eea, #764ba2); min-height: 100vh; display: flex; align-items: center; justify-content: center; } form { background: white; padding: 3rem; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.2); max-width: 500px; width: 90%; } input, textarea { width: 100%; padding: 1rem; margin-bottom: 1rem; border: 2px solid #ddd; border-radius: 8px; } button { width: 100%; padding: 1rem; background: #667eea; color: white; border: none; border-radius: 8px; font-size: 1.1rem; cursor: pointer; }</style></head><body><form><h2>Contact Us</h2><input type=\"text\" placeholder=\"Name\" required><input type=\"email\" placeholder=\"Email\" required><textarea rows=\"5\" placeholder=\"Message\" required></textarea><button type=\"submit\">Send</button></form></body></html>", "category": "Forms"}
{"instruction": "Make a signup form with validation", "output": "<!DOCTYPE html><html><head><meta charset=\"UTF-8\"><title>Contact Form</title><style>* { margin: 0; padding: 0; box-sizing: border-box; } body { font-family: Arial; background: linear-gradient(135deg, #667eea, #764ba2); min-height: 100vh; display: flex; align-items: center; justify-content: center; } form { background: white; padding: 3rem; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.2); max-width: 500px; width: 90%; } input, textarea { width: 100%; padding: 1rem; margin-bottom: 1rem; border: 2px solid #ddd; border-radius: 8px; } button { width: 100%; padding: 1rem; background: #667eea; color: white; border: none; border-radius: 8px; font-size: 1.1rem; cursor: pointer; }</style></head><body><form><h2>Contact Us</h2><input type=\"text\" placeholder=\"Name\" required><input type=\"email\" placeholder=\"Email\" required><textarea rows=\"5\" placeholder=\"Message\" required></textarea><button type=\"submit\">Send</button></form></body></html>", "category": "Forms"}
